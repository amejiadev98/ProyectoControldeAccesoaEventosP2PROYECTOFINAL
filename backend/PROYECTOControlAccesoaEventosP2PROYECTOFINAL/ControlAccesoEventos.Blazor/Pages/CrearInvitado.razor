@page "/invitados/crear"
@inject ControlAccesoEventos.Blazor.Services.InvitadoService InvitadoService
@inject NavigationManager NavigationManager

<h3>Crear Invitado</h3>

<EditForm Model="invitado" OnValidSubmit="HandleValidSubmit">
	<DataAnnotationsValidator />
	<ValidationSummary />

	<div class="mb-3">
		<label class="form-label">Nombre</label>
		<InputText class="form-control" @bind-Value="invitado.Nombre" />
	</div>

	<div class="mb-3">
		<label class="form-label">Apellidos</label>
		<InputText class="form-control" @bind-Value="invitado.Apellidos" />
	</div>

	<div class="mb-3">
		<label class="form-label">Documento Identidad</label>
		<InputText class="form-control" @bind-Value="invitado.DocumentoIdentidad" />
	</div>

	<div class="mb-3">
		<label class="form-label">Email</label>
		<InputText class="form-control" @bind-Value="invitado.Email" />
	</div>

	<div class="mb-3">
		<label class="form-label">Telefono</label>
		<InputText class="form-control" @bind-Value="invitado.Telefono" />
	</div>

	<button class="btn btn-primary" type="submit">Guardar</button>
	<button class="btn btn-secondary ms-2" type="button" @onclick="Cancel">Cancelar</button>
</EditForm>

@code {
	private ControlAccesoEventos.Blazor.DTOs.InvitadoDto invitado = new();

	private async Task HandleValidSubmit()
	{
		var resp = await InvitadoService.CreateAsync(invitado);
		if (resp.IsSuccessStatusCode)
		{
			NavigationManager.NavigateTo("/invitados");
		}
	}

	private void Cancel() => NavigationManager.NavigateTo("/invitados");
}
