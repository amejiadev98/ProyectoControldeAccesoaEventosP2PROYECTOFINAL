@page "/validaciones/editar/{Id:int}"
@inject ControlAccesoEventos.Blazor.Services.ValidacionService ValidacionService
@inject ControlAccesoEventos.Blazor.Services.EntradaService EntradaService
@inject NavigationManager NavigationManager

<h3>Editar Validacion</h3>

@if (validacion == null)
{
	<p>Cargando...</p>
}
else
{
	<EditForm Model="validacion" OnValidSubmit="HandleValidSubmit">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div class="mb-3">
			<label class="form-label">Entrada</label>
			<InputSelect class="form-select" @bind-Value="validacion.EntradaId">
				<option value="">-- Seleccione --</option>
				@foreach (var e in entradas)
				{
					<option value="@e.Id">@e.CodigoAcceso (@e.FechaEmision.ToString("g"))</option>
				}
			</InputSelect>
		</div>

		<div class="mb-3">
			<label class="form-label">Resultado</label>
			<InputText class="form-control" @bind-Value="validacion.Resultado" />
		</div>

		<div class="mb-3">
			<label class="form-label">Ubicacion</label>
			<InputText class="form-control" @bind-Value="validacion.Ubicacion" />
		</div>

		<div class="mb-3">
			<label class="form-label">Observacion</label>
			<InputTextArea class="form-control" @bind-Value="validacion.Observacion" />
		</div>

		<button class="btn btn-primary" type="submit">Guardar</button>
		<button class="btn btn-secondary ms-2" type="button" @onclick="Cancel">Cancelar</button>
	</EditForm>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private ControlAccesoEventos.Blazor.DTOs.ValidacionDto? validacion;
	private List<ControlAccesoEventos.Blazor.DTOs.EntradaDto> entradas = new();

	protected override async Task OnInitializedAsync()
	{
		entradas = await EntradaService.GetAllAsync();
		validacion = await ValidacionService.GetByIdAsync(Id);
	}

	private async Task HandleValidSubmit()
	{
		if (validacion == null)
		{
			// Nothing to update
			return;
		}

		var resp = await ValidacionService.UpdateAsync(Id, validacion);
		if (resp.IsSuccessStatusCode)
		{
			NavigationManager.NavigateTo("/validaciones");
		}
	}

	private void Cancel() => NavigationManager.NavigateTo("/validaciones");
}
