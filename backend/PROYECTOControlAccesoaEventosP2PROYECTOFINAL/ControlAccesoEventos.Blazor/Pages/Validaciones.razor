@page "/validaciones"
@inject ControlAccesoEventos.Blazor.Services.ValidacionService ValidacionService

<h3>Validaciones</h3>

<button class="btn btn-primary mb-3" @onclick="CreateNew">Crear Validacion</button>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Id</th>
			<th>EntradaId</th>
			<th>Resultado</th>
			<th>FechaHora</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@if (_validaciones != null)
		{
			@foreach (var v in _validaciones)
			{
				<tr>
					<td>@v.Id</td>
					<td>@v.EntradaId</td>
					<td>@v.Resultado</td>
					<td>@v.FechaHora.ToString("g")</td>
					<td>
						<button class="btn btn-sm btn-secondary" @onclick="() => Edit(v.Id)">Editar</button>
						<button class="btn btn-sm btn-danger" @onclick="() => Delete(v.Id)">Eliminar</button>
					</td>
				</tr>
			}
		}
	</tbody>
</table>

@code {
	private List<ValidacionDto> _validaciones = new List<ValidacionDto>();

	protected override async Task OnInitializedAsync()
	{
		_validaciones = await ValidacionService.GetAllAsync() ?? new List<ValidacionDto>();
	}

	private void CreateNew() => NavigationManager.NavigateTo("/validaciones/crear");

	[Inject]
	protected NavigationManager NavigationManager { get; set; }

	private void Edit(int id) => NavigationManager.NavigateTo($"/validaciones/editar/{id}");

	private async Task Delete(int id)
	{
		await ValidacionService.DeleteAsync(id);
		_validaciones = await ValidacionService.GetAllAsync() ?? new List<ValidacionDto>();
		StateHasChanged();
	}
}    


