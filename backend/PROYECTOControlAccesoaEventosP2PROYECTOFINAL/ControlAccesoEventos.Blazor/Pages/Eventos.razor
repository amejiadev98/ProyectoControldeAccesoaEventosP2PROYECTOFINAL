@page "/eventos"
@inject ControlAccesoEventos.Blazor.Services.EventoService EventoService

<h3>Eventos</h3>

<button class="btn btn-primary mb-3" @onclick="CreateNew">Crear Evento</button>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Fecha</th>
			<th>Lugar</th>
			<th>Capacidad</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@if (_eventos != null)
		{
			@foreach (var e in _eventos)
			{
				<tr>
					<td>@e.Id</td>
					<td>@e.Nombre</td>
					<td>@e.Fecha.ToString("g")</td>
					<td>@e.Lugar</td>
					<td>@e.Capacidad</td>
					<td>
						<button class="btn btn-sm btn-secondary" @onclick="() => Edit(e.Id)">Editar</button>
						<button class="btn btn-sm btn-danger" @onclick="() => Delete(e.Id)">Eliminar</button>
					</td>
				</tr>
			}
		}
	</tbody>
</table>

@code {
	private List<ControlAccesoEventos.Blazor.DTOs.EventoDto> _eventos;

	protected override async Task OnInitializedAsync()
	{
		_eventos = await EventoService.GetAllAsync();
	}

	private void CreateNew()
	{
		NavigationManager.NavigateTo("/eventos/crear");
	}

	[Inject]
	protected NavigationManager NavigationManager { get; set; }

	private void Edit(int id) => NavigationManager.NavigateTo($"/eventos/editar/{id}");

	private async Task Delete(int id)
	{
		await EventoService.DeleteAsync(id);
		_eventos = await EventoService.GetAllAsync();
		StateHasChanged();
	}
}
