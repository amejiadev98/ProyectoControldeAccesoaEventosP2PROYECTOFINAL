@page "/invitados"
@inject ControlAccesoEventos.Blazor.Services.InvitadoService InvitadoService

<h3>Invitados</h3>

<button class="btn btn-primary mb-3" @onclick="CreateNew">Crear Invitado</button>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Documento</th>
			<th>Email</th>
			<th>Teléfono</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@if (_invitados != null)
		{
			@foreach (var i in _invitados)
			{
				<tr>
					<td>@i.Id</td>
					<td>@i.Nombre @i.Apellidos</td>
					<td>@i.DocumentoIdentidad</td>
					<td>@i.Email</td>
					<td>@i.Telefono</td>
					<td>
						<button class="btn btn-sm btn-secondary" @onclick="() => Edit(i.Id)">Editar</button>
						<button class="btn btn-sm btn-danger" @onclick="() => Delete(i.Id)">Eliminar</button>
					</td>
				</tr>
			}
		}
	</tbody>
</table>

@code {
	private List<ControlAccesoEventos.Blazor.DTOs.InvitadoDto> _invitados;

	protected override async Task OnInitializedAsync()
	{
		_invitados = await InvitadoService.GetAllAsync();
	}

	private void CreateNew()
	{
		NavigationManager.NavigateTo("/invitados/crear");
	}

	[Inject]
	protected NavigationManager NavigationManager { get; set; }

	private void Edit(int id) => NavigationManager.NavigateTo($"/invitados/editar/{id}");

	private async Task Delete(int id)
	{
		await InvitadoService.DeleteAsync(id);
		_invitados = await InvitadoService.GetAllAsync();
		StateHasChanged();
	}
}
