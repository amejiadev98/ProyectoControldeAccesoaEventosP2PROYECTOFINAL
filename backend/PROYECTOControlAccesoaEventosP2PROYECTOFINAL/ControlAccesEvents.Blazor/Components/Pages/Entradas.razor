@page "/entradas"
@inject ControlAccesEvents.Blazor.Services.EntradaService EntradaService

<h3>Entradas</h3>

@if (!string.IsNullOrEmpty(EntradaService.LastError))
{
	<div class="alert alert-danger">@EntradaService.LastError</div>
}

<EditForm Model="newEntrada" OnValidSubmit="Create">
	<div class="row g-2">
		<div class="col-md-3">
			<InputText class="form-control" @bind-Value="newEntrada.Codigo" placeholder="Codigo" />
		</div>
		<div class="col-md-3">
			<InputNumber class="form-control" @bind-Value="newEntrada.EventoId" placeholder="EventoId" />
		</div>
		<div class="col-md-3">
			<InputNumber class="form-control" @bind-Value="newEntrada.InvitadoId" placeholder="InvitadoId" />
		</div>
		<div class="col-md-3">
			<button class="btn btn-primary">Crear</button>
		</div>
	</div>
</EditForm>

<table class="table mt-3">
	<thead>
		<tr>
			<th>Id</th>
			<th>Codigo</th>
			<th>EventoId</th>
			<th>InvitadoId</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@if (entradas is null)
		{
			<tr><td colspan="5">Cargando...</td></tr>
		}
		else if (entradas.Count == 0)
		{
			<tr><td colspan="5">No hay entradas.</td></tr>
		}
		else
		{
			@foreach (var e in entradas)
			{
				<tr>
					<td>@e.Id</td>
					<td>@e.Codigo</td>
					<td>@e.EventoId</td>
					<td>@e.InvitadoId</td>
					<td>
						<button class="btn btn-sm btn-danger" @onclick="() => Delete(e.Id)">Eliminar</button>
					</td>
				</tr>
			}
		}
	</tbody>
</table>

@code {
	private List<ControlAccesEvents.Blazor.DTOs.EntradaDto>? entradas;
	private ControlAccesEvents.Blazor.DTOs.EntradaDto newEntrada = new();

	protected override async Task OnInitializedAsync()
	{
		entradas = await EntradaService.GetAllAsync();
	}

	private async Task Create()
	{
		var ok = await EntradaService.CreateAsync(newEntrada);
		if (ok)
		{
			newEntrada = new();
			entradas = await EntradaService.GetAllAsync();
		}
	}

	private async Task Delete(int id)
	{
		await EntradaService.DeleteAsync(id);
		entradas = await EntradaService.GetAllAsync();
	}
}
